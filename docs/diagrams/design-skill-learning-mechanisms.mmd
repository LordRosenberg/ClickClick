flowchart TB
    subgraph research["Trajectory and research / Start from a completed task"]
        source["Source task evidence / Read step order and decisions first / Open original evidence as needed"]
        learner["Learner / Use the trace and verified recovery hints / Propose a grounded change or skip"]
        candidate["Conditional candidate / Bind the app, conditions and evidence / Tie revisions to the exact base text"]
    end
    subgraph review["Independent Skill Reviewer / Does not inherit the full dialogue"]
        independent["Independent evidence / Read original sources and frozen guidance / Bind judgments to candidate and role-specific text"]
        criteria["Six review dimensions / Root cause, transferability, conflict / Regression risk, concision, marginal value"]
        admission["Separate admission claims / Source evidence supports local guidance / Task benefit needs measured evidence"]
    end
    subgraph validation["Paired regression and release / Dedicated Android test fixture"]
        selective["Verify the cases / Reuse registered cases or record setup / Independently verify the initial state"]
        utility["Run both Skill versions / Same App build and initial state / Compare results, Skill use and cost"]
        publish["Versioned publication / Eligible low-impact changes publish automatically / Higher impact awaits human review"]
    end
    subgraph shared["Contracts and boundaries / Traceability and scoped execution"]
        binding["Exact evidence / Bind candidate, base library, delivered Skill and test fixture"]
        cost["Budget and stop conditions / The job shares a budget. Incomplete evidence preserves the active Skill."]
    end
    source --> learner
    learner -->|"propose"| candidate
    independent --> criteria
    criteria --> admission
    selective --> utility
    utility --> publish
    research --> review
    review --> validation
    validation -->|"Save results for follow-up research"| research
