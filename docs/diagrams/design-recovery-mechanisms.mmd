flowchart TB
    subgraph durable["Persist during execution / Do not wait for a crash to save"]
        intent["T1: save before dispatch / Decision, state, paired notes, dialogue refs / Operation ID, digest, budget reservation / Commit before any dispatch"]
        receipt["T2: persist original receipt / Driver journal retains independent facts / Harness stores returned receipt in task DB / The full step is not yet committed"]
        postState["T3: commit the full step / After post-view: step and full post-state / Atomic manifest and accounting settlement / Next round uses consistent task progress"]
    end
    subgraph takeover["Detect, record and isolate / Caught faults vs. hard crashes"]
        detect["Detect interruption / Caught fault: reason + recovering / Hard kill or power loss: no final save / Restart scans status and open operations"]
        owner["Take over task writes / execution_epoch + worker_token / Ordered shutdown retires old ownership / Old replies and finalizers cannot advance"]
        fence["Stop old device input / Monotonic device_fence and fence/drain / Bounded cleanup of task input children / Retain quarantine unless quiescent"]
    end
    subgraph continuation["Reconcile and continue / Check resources, then decide again"]
        reconcile["Reconcile the attempt / Query receipt and child facts / Unknown: settled_uncertain reservation / No replay or tail resume"]
        context["Restore state and context / Full post-state or later T1 plus durable facts / Original role, plan, notes, dialogue and skills / Check required bodies, device, model access"]
        fresh["Fresh view and new decision / recovery_current plus known/unknown facts / Never replay; a new action uses a new operation ID"]
    end
    subgraph shared["Contracts and boundaries / Cross-stage constraints and traceability"]
        dispatchContract["Resume from durable facts / No receipt: query or unknown; receipt: close step. / Full step committed: continue without replay."]
        accountingContract["Accounting and late facts / Keep budgets and deadline; append late facts once without duplicate charges or terminal revival"]
    end
    intent --> receipt
    receipt --> postState
    detect --> owner
    owner --> fence
    reconcile --> context
    context --> fresh
    durable --> takeover
    takeover --> continuation
