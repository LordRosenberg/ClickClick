flowchart TB
    subgraph research["轨迹与研究 / 从已结束的任务开始"]
        source["原任务证据 / 先看步骤顺序和决策 / 按需回查原始证据"]
        learner["Learner / 结合轨迹与已核验的接管线索 / 有依据时提出改动，也可以跳过"]
        candidate["条件化候选 / 绑定应用、适用条件和来源证据 / 修订绑定基础版本的确切正文"]
    end
    subgraph review["独立 Skill Reviewer / 不继承 Learner 整段对话"]
        independent["独立读取证据 / 按需读取原始来源与冻结指南 / 评审结论绑定实际候选和角色正文"]
        criteria["六项审查 / 根因、迁移性、冲突 / 退化风险、简洁性、边际价值"]
        admission["区分证据范围 / 来源证据支撑局部经验 / 整任务收益需要实测证据"]
    end
    subgraph validation["配对回归与发布 / 独立 Android 测试环境"]
        selective["选用例并验证 / 复用已登记用例，或补录准备脚本 / 独立核对初态"]
        utility["新旧 Skill 各跑一轮 / 同一 App 构建与初态 / 核对业务结果、Skill 使用和成本"]
        publish["版本化发布 / 符合条件的低影响改动自动发布 / 高影响改动待人工审核"]
    end
    subgraph shared["关键契约与边界 / 证据追溯与独立运行"]
        binding["证据绑定 / 绑定候选、基础库、实际交付的 Skill 和测试环境"]
        cost["预算与停止条件 / 作业共享累计预算。证据不足时保留当前版本。"]
    end
    source --> learner
    learner -->|"propose"| candidate
    independent --> criteria
    criteria --> admission
    selective --> utility
    utility --> publish
    research --> review
    review --> validation
    validation -->|"保留结果，供后续研究"| research
