flowchart TB
    subgraph questions["A Agent 主动提问 / 需要用户信息或明确授权时使用"]
        ask["中间工具 ask_user / Planner/Executor 可用，Reviewer 不提问 / managed 支持 1–3 题或一次明确确认"]
        broker["持久问题与单一入口 / 私有宿主 binding/SSE，失效转 Console / owner_version 与回复身份防止迟到覆盖"]
        continuation["原调用等待与续接 / 保存角色会话、invocation 与 tool-call / 释放 worker 保留设备；回答后刷新观测"]
    end
    subgraph steering["B 用户主动介入 / 修改进入原任务的有序记录"]
        inbox["持久控制收件箱 / request_key 幂等追加，不覆盖原需求 / 先落库再确认，accepted 不等于 applied"]
        revision["指令版本与调用资格 / 新要求更新 revision 和执行代次 / 未派发旧调用失去继续提交资格"]
        planner["Planner 解释新意图 / continue 保留有效阶段与 Executor 历史 / 受影响工作才重规划，保留已有事实"]
    end
    subgraph runtime["C 共享执行边界 / 阻止旧工作覆盖新意图"]
        eligibility["迟到响应处理 / revision、generation 与调用身份校验 / 旧响应可留诊断，不能派发或提交完成"]
        inflight["已派发动作排序 / 在途动作先保存真实回执和效果 / 再应用修改，不自动撤销手机副作用"]
        lifecycle["生命周期保持 / 暂停保持暂停；终态变更建立后续任务 / 预算、历史和原绝对时限不重置"]
    end
    subgraph shared["关键契约与边界 / 贯穿各阶段的约束与可追溯记录"]
        replyContract["问题与回复身份 / interaction_id · owner_version · response_id；相同重试只接受一次"]
        policyContract["创建时冻结策略 / HITL off 不自动开启；已有明确授权不重复索取，宿主呈现不代表用户同意"]
    end
    ask --> broker
    broker --> continuation
    inbox --> revision
    revision --> planner
    eligibility --> inflight
    inflight --> lifecycle
    questions -->|"问题回答续接原调用，并核对当前执行资格"| runtime
    steering --> runtime
