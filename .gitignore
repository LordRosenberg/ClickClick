# Keep shared debug launch configs; ignore personal editor prefs
.vscode/settings.json

# Local experiment dumps
/artifacts/

# Machine-local commit deny list (serials / usernames); see *.example
.githooks/local-block-patterns

# Local / private evaluation outputs (never commit; regenerate per machine)
/evaluation/fixtures/
/evaluation/results/
/evaluation/**/artifacts/
/evaluation/**/rows.json

# OpenSpec device evidence: bulky traces and screenshot packs
**/evidence/**/artifacts/
**/evidence/**/rows.json
**/evidence/**/som/
**/evidence/**/*.png
**/evidence/**/*.jpg
**/evidence/**/*.jpeg
**/evidence/**/*.webp
