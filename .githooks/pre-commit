#!/usr/bin/env bash
# Block private evaluation / device-evidence paths even if force-added.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
blocked='^(evaluation/(fixtures|results)/|evaluation/.*/(artifacts|rows\.json)$|.*/evidence/.*/(artifacts|rows\.json|som)/|.*/evidence/.*\.(png|jpe?g|webp)$)'

staged="$(git diff --cached --name-only --diff-filter=ACMR || true)"
if [[ -z "$staged" ]]; then
  exit 0
fi

bad="$(printf '%s\n' "$staged" | grep -E "$blocked" || true)"
if [[ -n "$bad" ]]; then
  echo "pre-commit: refusing private evaluation/evidence paths:" >&2
  printf '  %s\n' $bad >&2
  echo "These belong under local-only dirs (see .gitignore). Unstage with:" >&2
  echo "  git restore --staged <path>" >&2
  exit 1
fi

# Generic absolute home paths (no machine-specific usernames in-repo).
content_deny='/Users/|/home/[A-Za-z0-9._-]+/'
local_patterns="$ROOT/.githooks/local-block-patterns"
if [[ -f "$local_patterns" ]]; then
  # Optional untracked file: one regex per line (comments/# blank ignored).
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    content_deny="$content_deny|$line"
  done < "$local_patterns"
fi

if printf '%s\n' "$staged" | grep -E '\.(md|json|py|ts|tsx|yml|yaml|txt)$' >/dev/null; then
  if git diff --cached -U0 --diff-filter=ACMR -- '*.md' '*.json' '*.py' '*.ts' '*.tsx' '*.yml' '*.yaml' '*.txt' \
    | grep -E '^\+' | grep -Eiq -- "$content_deny"; then
    echo "pre-commit: staged diff reintroduces an absolute home path" >&2
    echo "(or a pattern from .githooks/local-block-patterns). Use relative paths / REDACTED_*." >&2
    exit 1
  fi
fi

exit 0
