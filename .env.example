# ClickClick configuration — deployment, model access and runtime selection.
# Most execution mechanics remain code-owned. Architecture and context settings
# are described in docs/architecture.md and docs/design-decisions.md.

# Default: Planner + Executor with explicit on-demand review. plan_reviewer
# requires final review. These are the only supported architectures.
# CLICKCLICK_AGENT_ARCHITECTURE=plan_executor
# Prefer model/role context settings inside CLICKCLICK_MODELS_JSON when tuning.
# CLICKCLICK_EXECUTOR_CONTEXT_TOKENS=16000

# --- LLM (required) -------------------------------------------------------
# Optional source HTTP MCP: run control_api.main and control_api.mcp_http
# in separate processes with the same workspace/data directory.
# CLICKCLICK_MCP_HTTP_ENABLED=true
# CLICKCLICK_MCP_HTTP_PORT=8081
# Model id MUST match a key in CLICKCLICK_MODELS_JSON and carry a litellm
# routing prefix. For an OpenAI-compatible API relay (中转站), use
# "openai/<model>" as the id, provider="openai", and base_url = relay
# endpoint (typically ends in /v1).
CLICKCLICK_DEFAULT_MODEL=openai/gpt-5.6-sol
CLICKCLICK_MODELS_JSON={"openai/gpt-5.6-sol":{"provider":"openai","base_url":"https://your-relay.example.com/v1","api_key":"sk-xxxxxx","max_tokens":4096,"reasoning_supported":false,"stream":false,"extra_body":{}}}
# Per-model top-level tool_choice: "required" (default) or "auto".
# Use "auto" only for models that need optional tool selection. Agent decisions
# still require a valid submit tool call. This alone does not enable thinking
# protocols that require reasoning_content to be returned in later requests.
# For a reasoning-capable provider/model, opt in explicitly. Unsupported
# providers receive no reasoning kwargs; summaries are diagnostic-only and
# are never copied into Manager/Executor decisions or task memory.
# CLICKCLICK_MODELS_JSON={"openai/o3":{"provider":"openai","api_key":"sk-xxxxxx","reasoning_supported":true,"reasoning":{"effort":"high","summary":"concise"},"stream":true}}
#
# ChatGPT Pro/Max subscription (LiteLLM chatgpt/*) can coexist with relay
# entries for A/B testing. No api_key/base_url/max_tokens. Login once first:
#   python -m shared.chatgpt_login
# Example mixed catalog (role overrides pick which model runs):
# CLICKCLICK_MODELS_JSON={"openai/gpt-4o":{"provider":"openai","base_url":"https://your-relay.example.com/v1","api_key":"sk-xxxxxx","max_tokens":4096,"stream":false},"chatgpt/gpt-5.6-sol":{"provider":"chatgpt","reasoning_supported":true,"reasoning":{"effort":"high","summary":"concise"},"stream":true}}
# CLICKCLICK_MANAGER_MODEL=chatgpt/gpt-5.6-sol
# CLICKCLICK_EXECUTOR_MODEL=openai/gpt-4o
# Optional token storage dir (exported as CHATGPT_TOKEN_DIR). Empty → LiteLLM
# default ~/.config/litellm/chatgpt.
# CLICKCLICK_CHATGPT_TOKEN_DIR=./data/chatgpt-auth
#
# Per-role overrides (optional). Each MUST be a key in CLICKCLICK_MODELS_JSON.
# Empty → that role uses CLICKCLICK_DEFAULT_MODEL.
# CLICKCLICK_MANAGER_MODEL=openai/claude-3-5-sonnet
# CLICKCLICK_EXECUTOR_MODEL=openai/gpt-4o-mini
# User-Agent header applied to every LLM HTTP request (via litellm extra_headers),
# except ChatGPT subscription routes (Codex keeps its own client identity).
# Empty → built-in default desktop Firefox UA. Override if a relay's风控 rejects
# the default or requires a specific UA.
# CLICKCLICK_GATEWAY_USER_AGENT=

# --- Console access -------------------------------------------------------
# Bind address. Default 127.0.0.1 = this machine only; set 0.0.0.0 to let
# other LAN devices (phones, colleagues' browsers) open the console too.
# CLICKCLICK_API_HOST=0.0.0.0
# HTTPS for the console. Recommended together with 0.0.0.0: over plain
# http:// browsers treat LAN origins as insecure and disable WebCodecs, so
# remote viewers can load the page but the LIVE mirror can never decode.
# The self-signed cert is auto-generated at startup (covers the machine's
# current LAN IPs, regenerated automatically when the IP changes) — no
# manual step. Typing `192.168.x.x:8080` without a scheme auto-redirects
# to https://. Remote browsers click through the cert warning once; nothing
# needs to be installed on client devices. Leave both empty for plain HTTP.
# CLICKCLICK_API_SSL_CERTFILE=./data/certs/cert.pem
# CLICKCLICK_API_SSL_KEYFILE=./data/certs/key.pem

# --- Driver (set only for remote driver process; empty = local ADB) -------
CLICKCLICK_DRIVER_URL=http://127.0.0.1:8765

# --- Optional device provisioning -----------------------------------------
# CLICKCLICK_ACCESSIBILITY_COLLECTOR_ENABLED=true
# Device APKs. Collector path may stay unset: startup auto-discovers a matching
# matching local Gradle build, then pinned SHA-256 verified Release; installs/upgrades idle devices.
# CLICKCLICK_ACCESSIBILITY_COLLECTOR_APK_PATH=android/accessibility-collector/app/build/outputs/apk/debug/app-debug.apk
# CLICKCLICK_IME_APK_PATH=data/device-apks/ADBKeyboard.apk
# Or run: ./scripts/bootstrap-device.sh
# CLICKCLICK_DEVICE_STAY_AWAKE_WHILE_PLUGGED=false

# --- Optional Jev text-fidelity experiment -------------------------------
# Defaults OFF. Configure in this isolated checkout's .env, never an active
# evaluation's .env. The runtime and devtools.jev_summary_replay load .env.
# off = original compaction; shadow = audit only; enforce = one correction,
# atomic admission. External checks need both a key and external consent.
# CLICKCLICK_JEV_MODE=enforce
# CLICKCLICK_JEV_ALLOW_EXTERNAL=true
# TYPESAFE_API_KEY=
# Alternative/override: CLICKCLICK_JEV_API_KEY= (masked in Settings).
# CLICKCLICK_JEV_BASE_URL=https://api.typesafe.ai
# CLICKCLICK_JEV_MODEL=jev-1.13.0
# CLICKCLICK_JEV_TIMEOUT_S=8
# CLICKCLICK_JEV_COMPACTION_TIMEOUT_S=90
# Default: Jev failures must not introduce case failures. No service retry;
# admit mechanically valid items as unvalidated and cool down for 60 seconds.
# CLICKCLICK_JEV_FAILURE_POLICY=bypass
# CLICKCLICK_JEV_FAILURE_COOLDOWN_S=60
# Optional strict experiment only: rollback (may fail for insufficient capacity).
# Frozen historical-replay profile; docs/jev-final-harness-20261002.md.
# Two phases: exact original assertion fidelity, then relation/types/target details.
# Noul fidelity is p(faithful); reject on 1-p. Choice confidence is diagnostic.
# Gray checks are admitted without semantic validation or another LLM call.
# CLICKCLICK_JEV_CHECK_STRATEGY=facets
# CLICKCLICK_JEV_SUPPORT_THRESHOLD=0.6
# CLICKCLICK_JEV_FIDELITY_REJECT_THRESHOLD=0.88
# CLICKCLICK_JEV_WHOLE_REJECT_THRESHOLD=0.95
# CLICKCLICK_JEV_DETAIL_REJECT_THRESHOLD=0.74
# Compatibility relation strategy only; type heads are diagnostic in facets:
# CLICKCLICK_JEV_REJECT_THRESHOLD=1.0
# CLICKCLICK_JEV_ISSUE_THRESHOLD=0.85
# CLICKCLICK_JEV_MAX_SOURCE_CHARS=160000
# CLICKCLICK_JEV_MAX_STATE_TOKENS=28000
# CLICKCLICK_JEV_MAX_REQUEST_TOKENS=56000
# Enforce never retries the TypeSafe transport. Usage and raw answers are stored
# in task artifacts/jev-checks. After one failed correction, the harness keeps
# accepted/unassessed items and audits omitted known rejections; no third call.
# Original records remain durable and recent steps remain in context.
# rollback alone requires known, sufficient context.max_input_tokens for raw
# continuation. AgentSession still checks the complete request before actions.
# LiteLLM Proxy: use its virtual key and CLICKCLICK_JEV_BASE_URL=http://127.0.0.1:4000/typesafe
# (HTTPS required for a remote proxy). No LiteLLM upgrade is made here.
# Legacy devtools.jev_replay still uses shell env only, without loading .env.
